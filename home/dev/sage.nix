{ config, pkgs, lib, ... }:

{
  # --------------------------------------------------------------------------
  # programs.sagemath ─ 顶层命名空间, 所有 SageMath 选项均在此之下
  # --------------------------------------------------------------------------
  programs.sagemath = {

    # ========================================================================
    # 1. enable ─ 是否启用 SageMath
    # ========================================================================
    # 类型: boolean
    # 说明: 启用后 Home Manager 将自动安装 sage，并管理相关配置文件
    #       和会话环境变量.
    # ========================================================================
    enable = true;

    # ========================================================================
    # 2. package ─ 要使用的 SageMath 包
    # ========================================================================
    # 类型: null or package
    # 默认值: pkgs.sage
    # 说明: 指定安装哪个 SageMath 衍生包.
    #       - pkgs.sage         : 标准版本 (当前 nixpkgs 版本 10.7)
    #       - pkgs.sageWithDoc  : 包含内置文档的版本(会增加编译时间和磁盘占用)
    #       - null              : 不安装 sage 仅管理配置文件和会话变量
    # ========================================================================
    package = pkgs.sageWithDoc;

    # ------------------------------------------------------------------------
    # # 备选: 使用带文档的版本(编译时间更长, 但内置完整帮助文档)
    # package = pkgs.sage;
    # ------------------------------------------------------------------------
    # # 备选: 仅管理配置文件而不安装 SageMath(适合已通过其他方式安装的场景)
    # package = null;
    # ------------------------------------------------------------------------

    # ========================================================================
    # 3. configDir ─ sage.init 配置文件存储目录
    # ========================================================================
    # 类型: string
    # 默认值: "${config.xdg.configHome}/sage" (即 ~/.config/sage)
    # 说明: 存放 SageMath 启动时自动加载的 `init.sage` 文件的目录.
    #       而 SageMath 官方默认使用 ~/.sage(非 XDG). 此处保留 HM 的 XDG 默认.
    # ========================================================================
    configDir = "${config.xdg.configHome}/sage";

    # ------------------------------------------------------------------------
    # 备选: 若要模仿 SageMath 官方默认行为(存放在 ~/.sage 下):
    # configDir = "${config.home.homeDirectory}/.sage";
    # ------------------------------------------------------------------------

    # ========================================================================
    # 4. dataDir ─ DOT_SAGE 数据目录
    # ========================================================================
    # 类型: string
    # 默认值: "${config.xdg.dataHome}/sage" (即 ~/.local/share/sage)
    # 说明: SageMath 运行时数据(如缓存的编译文件、下载的可选包等)存储位置.
    #       通过环境变量 `DOT_SAGE` 传递给 sage 进程.
    #       而 SageMath 官方默认使用 ~/.sage. 此处保留 HM 的 XDG 默认
    # ========================================================================
    dataDir = "${config.xdg.dataHome}/sage";

    # ------------------------------------------------------------------------
    # 备选: 若要模仿 SageMath 官方默认行为(存放在 ~/.sage 下):
    # dataDir = "${config.home.homeDirectory}/.sage";
    # ------------------------------------------------------------------------

    # ========================================================================
    # 5. initScript ─ Sage 启动时自动执行的初始化脚本
    # ========================================================================
    # 类型: strings concatenated with "\n" (types.lines)
    # 默认值: "" (空)
    # 官方案例: "%colors linux"
    # 说明: 此内容写入 ${configDir}/init.sage 文件, SageMath 每次启动时会
    #       自动加载并执行. 可以在这里设置配色方案、预加载常用包、
    #       定义常用函数等.
    # ========================================================================
    initScript = ''
      # ===== SageMath 启动初始化脚本 (init.sage) =====
      # 此文件由 Home Manager 自动生成, 手动修改会被覆盖.

      # -- 终端配色方案(在 Jupyter 中无效，仅影响终端 REPL) --
      %colors linux

      # -- 启动时打印当前版本 --
      print("SageMath 版本: {}".format(version()))

      # -- 自动加载整数数列在线百科全书(OEIS)查询 --
      # 取消注释以启用 OEIS 集成:
      # oeis()

      # -- 预加载常用模块和类型(示例, 按需启用) --
      # from sage.all import *

      # -- 设置大整数输出不截断 --
      # 取消注释以禁用整数截断显示:
      # Integer.__repr__ = lambda self: self.str()

      # -- 科研工作中常用的自定义辅助函数示例 --
      # def p(x):
      #     """快速打印变量的 LaTeX 形式"""
      #     from sage.misc.latex import latex
      #     print(latex(x))

      # -- 启用并行计算(如果系统有多个 CPU 核心) --
      # 取消注释以在启动时自动设定并行线程数:
      # Parallelism().set(nproc=4)

      # -- 设定 Jupyter 输出为高分辨率矢量图 (适用于 JupyterLab / Notebook) --
      # 取消注释以设置 SVG 矢量格式输出:
      # %display svg
    '';

    # ------------------------------------------------------------------------
    # 最简 initScript 示例(仅配色):
    # initScript = "%colors linux";
    #
    # 空 initScript (不使用初始化脚本):
    # initScript = "";
    # ------------------------------------------------------------------------
  };

  # ==========================================================================
  # 可选: 手动安装额外的 SageMath 辅助包到 home.packages
  # ==========================================================================
  # 以下包的说明:
  #   sageWithDoc   ─ SageMath + 内置文档(已在上方 package 选项中提供备选)
  #   sagetex       ─ 允许在 LaTeX 文档中嵌入 SageMath 计算和图形
  #
  # 如果需要 sagetex, 添加以下行:
  home.packages = with pkgs; [
    sagetex
  ];
  #
  # 注意: 若 package 设置为 null(不安装 sage), 你需要自行将 sage 添加到
  # home.packages 中以确保 sage 可执行文件在 $PATH 中可用.
  # ==========================================================================

  # ==========================================================================
  # 可选: 若使用 Jupyter 环境, 建议配合安装 jupyter
  # ==========================================================================
  # SageMath 后端可作为 Jupyter kernel 使用. 确保安装了 jupyter 后,
  # 在 SageMath 的 sage 命令行中运行:
  #   sage -n jupyter
  # 即可在浏览器中打开 Jupyter Notebook 并使用 Sage 内核.
  #
  # 若要在 home.nix 中一并启用 JupyterLab:
  # home.packages = with pkgs; [
  #   jupyter
  # ];
  # ==========================================================================
}
