{
  # =========================================================
  # 自定义命令
  # =========================================================
  #
  # 命令: /git-commit
  # 功能: 根据 git diff HEAD 生成符合 Conventional Commits 规范的提交信息
  # 用法: /git-commit [补充说明]
  #
  "git-commit" = {
    # 在 TUI 命令面板中显示的描述
    description = "根据 git diff 生成符合 Conventional Commits 规范的提交信息";

    # 提示词模板
    template = ''
      请根据以下 git diff HEAD 的输出，生成一份规范的 git commit 信息。$ARGUMENTS

      要求：
      1. 严格遵循 Conventional Commits 规范: <type>(<scope>): <description>
      2. type 从下列中选择: feat, fix, docs, style, refactor, perf, test, chore, ci, build, revert
      3. 若变更范围明确，使用 scope 进行标识 (例: fix(auth): 修复登录验证码失效问题)
      4. description 使用中文编写，简洁明了，以句号结尾，建议不超过 50 字
      5. body 使用中文详细描述:
         - 变更内容: 改了什么、怎么改的
         - 变更原因: 为什么这样改
         - 影响范围: 对哪些模块或功能有影响
         body 与 subject 之间留一空行
      6. 若存在破坏性变更，在 footer 中添加 BREAKING CHANGE 段落后跟中文说明
      7. 若有关联的 issue 或 PR，在 footer 中以 Closes #xxx / Refs #xxx 格式引用
      8. 仅输出 commit message 本身，不要包裹在 markdown code block 中，不要添加任何额外解释

      输出格式：
        <type>(<scope>): <中文简述>

        <中文详细描述>

        <footer>

      以下是 git diff HEAD 的输出：

      !`git diff HEAD`
    '';

    # 以子任务方式执行，结果返回到当前会话且不污染主上下文
    subtask = true;
  };

  # =========================================================
  # 命令: /impl
  # 功能: 将需求描述转换为可直接交付 LLM 实现的结构化提示词
  # 用法: /impl <需求描述>
  # =========================================================
  "impl" = {
    description = "将需求转换为面向 LLM 的结构化实现提示词";

    template = ''
      你是一位专精于 AI Prompt 工程的资深工程师。你的任务是把下方的需求描述, 转换成一份可直接交付 LLM 执行的结构化实现提示词。

      需求描述: $ARGUMENTS

      生成的提示词必须包含以下章节, 且每个章节都应具体、可操作:

      ## 角色与目标
      - 明确 LLM 在本次实现中扮演的角色 (如: 你是一位精通 TypeScript 的全栈工程师)
      - 用一句话概括需要达成的最终状态

      ## 前置上下文
      - 指明 LLM 应先阅读的关键文件或模块
      - 需要理解的项目约定 (目录结构、命名规则、已有工具函数)

      ## 实现要求
      将需求拆解为有序的原子步骤, 每步包含:
      - 位置: 目标文件路径
      - 操作: 新增/修改/删除 的具体描述
      - 细节: 函数签名、类型定义、关键逻辑说明
      - 结果: 该步骤完成后预期看到的行为或状态

      ## 风格约束
      - 代码规范: 缩进风格、命名约定、注释语言
      - 错误处理: 何时 panic、何时静默降级、何时返回 Result
      - 库与工具: 应使用的包/库 (优先复用项目中已有的依赖)
      - 测试要求: 测试文件路径、需要覆盖的场景

      ## 边界与约束
      - 禁止修改的范围: 明确列出不可触碰的文件或模块
      - 兼容性: 需要保持向后兼容的接口
      - 性能与安全: 相关的硬性指标或注意事项

      生成原则:
      1. 提示词输出后应可直接用作 system prompt, 无需二次加工
      2. 每个指令必须明确可执行, 避免 "适当处理"、"合理设计" 等模糊措辞
      3. 技术细节精确到位: 函数名、参数类型、返回值、模块路径
      4. 提示词篇幅适中, 关键约束前置
      5. 使用中文编写说明, 代码和技术术语可用原文

      请直接输出生成的实现提示词本身, 不要包裹在 markdown code block 中。
    '';

    subtask = true;
  };
}
