#!/usr/bin/env python3
# 依赖于 python 的 magic 模块
from typing import Optional
from pathlib import Path
import argparse
import os
import sys


def get_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="用于 fzf 预览功能的预览脚本.")
    parser.add_argument('content', help="传入需要预览的内容", type=str)
    # fzf 传进来的路径可能以 - 开头 (仓库的 fzf 用 fd --strip-cwd-prefix, 会产出裸
    # 相对路径), argparse 会把它当选项; 单参数时前置 -- 强制按位置参数解析
    argv = sys.argv[1:]
    if len(argv) == 1 and argv[0] not in ('-h', '--help'):
        argv = ['--'] + argv
    return parser.parse_args(argv)


def get_file_mime_type(path: Path) -> str:
    import magic
    try:
        mime = magic.Magic(mime=True)
        return mime.from_file(path)
    except Exception:
        raise RuntimeError("无法获取文件类型, 确保已安装 libmagic 并正确配置 python-magic 模块.")


def get_file_info(path: Path) -> str:
    import magic
    try:
        return magic.Magic().from_file(path)
    except Exception:
        raise RuntimeError("无法获取文件信息, 确保已安装 libmagic 并正确配置 python-magic 模块.")


def _is_safe_to_print(file_path: Path, sample_size: int = 4096) -> bool:
    """
    检查文件前 N 个字节，看是否包含二进制控制字符。
    这是 cat/bat 判断是否打印的核心逻辑。
    """
    try:
        with open(file_path, 'rb') as f:
            chunk = f.read(sample_size)
            # 如果包含空字节，绝对不是纯文本
            if b'\x00' in chunk:
                return False
            
            # 可选：检查不可打印字符的比例
            # 这里简单处理：如果能用 utf-8 解码，基本就是安全的
            try:
                chunk.decode('utf-8')
                return True
            except UnicodeDecodeError:
                # 如果 utf-8 失败，可能是 GBK 或其他编码，
                # 只要没 \0，cat 通常也能吐出内容（虽然可能乱码）
                return True 
    except Exception:
        return False



def is_text_file(path: Path) -> bool:
    file_type = get_file_mime_type(path)

    if (file_type.startswith('text/') or 
        file_type in [
            'application/json',
            'application/xml',
            'application/javascript',
            'application/x-yaml',
            'application/x-sh',
            'application/x-python',
            'application/x-perl',
            'application/x-ruby',
        ]):
        return True

    if file_type == 'application/octet-stream':
        return _is_safe_to_print(path)

    return False


def is_valid_image(file_path: Path, deep_check: bool = False) -> bool:
    from PIL import Image
    # 1. 第一步：快速 MIME 检测 (非阻塞)
    try:
        file_type = get_file_mime_type(file_path)
    except Exception:
        return False

    if not file_type.startswith('image/'):
        return False

    # 2. 第二步：深度校验 (可选，涉及磁盘 IO)
    # 针对需要确保文件没损坏、不是伪造文件的场景
    if deep_check:
        try:
            with Image.open(file_path) as img:
                img.verify() # 验证文件完整性，不解码整个图像，速度快
            return True
        except Exception:
            return False
            
    return True


def exec_cmd(exec_path: Path, args: list[str], env: dict[str, str]) -> None:
    import platform
    
    match platform.system():
        case 'Linux' | 'Darwin':
            os.execve(exec_path, [str(exec_path)] + args, env)
        case 'Windows':
            import subprocess
            subprocess.run(
                [str(exec_path)] + args,
                capture_output=False,
                check=True,
            )
        case _:
            raise RuntimeError(f"不支持的操作系统: {platform.system()}")


def main() -> None:
    import shutil

    env: dict[str, str] = os.environ.copy()
    content: str = get_args().content.strip()

    cmd: Optional[str]
    cmd_path: Optional[Path]
    args: list[str]

    if not Path(content).exists():
        print(content)
        return

    content_path = Path(content)

    # 以 - 开头的相对路径会被子命令 (bat/eza/chafa/ls) 当成选项 —— 仓库的 fzf 用
    # fd --strip-cwd-prefix, 会产出这种裸相对路径。只在传给子命令时补 ./ 前缀规避
    # (chafa 不认 -- 分隔符, 所以不能统一靠 -- 解决)
    arg_path = f'./{content}' if content.startswith('-') and not content.startswith('/') else content
    
    if content_path.is_dir():
        cmd = shutil.which('eza')
        args = [
            '--icons',
            '--tree',
            '--level=2',
            '--color=always',
            '--git',
            '--git-ignore',
            arg_path,
        ]
    elif is_text_file(content_path):
        cmd = shutil.which('bat')
        args = [
                '--style=numbers',
                '--color=always',
                '--line-range=:500',
                arg_path,
        ]
    elif is_valid_image(content_path, deep_check=True):
        cmd = shutil.which('chafa')
        args = [
            arg_path,
            '--fill=block',
            '--symbols=block',
            '--size=60x50',
        ]
    else:
        file_info = get_file_info(content_path)
        # flush: 下面直接 execve 换进程, 不 flush 的话这行会随 Python 的块缓冲
        # 一起丢掉 (fzf 的预览窗是管道, 实测默认缓冲下这行永远不显示)
        print(f"无法预览该文件，文件信息:\n{file_info}", flush=True)
        cmd = shutil.which('eza') or shutil.which('ls')
        args = [
            '--long',
            '--color=always',
            '--git',
            '--git-ignore',
            arg_path,
        ] if cmd and cmd.endswith('eza') else ['-l', '--color=auto', arg_path]

    if cmd is None:
        print("未找到合适的预览工具, 请确认 bat / eza / chafa 已安装在 PATH 中.")
        return

    cmd_path = Path(cmd)

    exec_cmd(cmd_path, args, env)


if __name__ == '__main__':
    main()

