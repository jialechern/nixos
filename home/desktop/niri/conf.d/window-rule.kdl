// window-rule.kdl
// 此处存放 niri 环境中 必要/可选 的窗口规则配置

// 让 awww/swww 的壁纸同时进入 overview 的 backdrop
layer-rule {
    match namespace="^(swww-daemon|awww-daemon)$"
    place-within-backdrop true
}

// 使 Rofi 启动器获得毛玻璃模糊特效
layer-rule {
    match namespace="^rofi$"

    opacity 0.88

    geometry-corner-radius 12

    background-effect {
        blur true
    }
}

// Waybar 状态栏: 本体圆角由 CSS 负责 (geometry-corner-radius 仅影响 shadow/blur);
// 弹出菜单额外加半透明与毛玻璃模糊。
layer-rule {
    match namespace="^waybar$"

    geometry-corner-radius 12

    popups {
        geometry-corner-radius 10
        opacity 0.88

        background-effect {
            blur true
        }
    }
}

// Mako 通知: 毛玻璃 + 不进录屏 (mako 的命名空间是 "notifications", 不是 "mako")
layer-rule {
    match namespace="^notifications$"

    geometry-corner-radius 8
    opacity 0.92

    // 通知内容可能包含敏感信息，不进入录屏 (仍可正常出现在屏幕上)
    block-out-from "screencast"

    background-effect {
        blur true
    }
}

// 26.04: top/overlay 层用非 xray 模糊, 让 rofi/mako 透出下层窗口。
// 非 xray 更贵, 且仅对已开启 blur 的层生效。
layer-rule {
    match layer="top"
    match layer="overlay"

    background-effect {
        xray false
    }
}

// 窗口匹配器（match）完整列表:
//   match app-id="..." — 按 app-id 匹配
//   match title="..."  — 按窗口标题匹配
//   match is-active=true        — 匹配活动窗口
//   match is-focused=false      — 匹配未聚焦窗口
//   match is-active-in-column=true — 匹配列内活动窗口
//   match is-floating=true      — 匹配浮动窗口
//   match is-window-cast-target=true — 匹配屏幕录制目标窗口
//   match is-urgent=true        — 匹配紧急窗口
//   match at-startup=true       — 仅在 niri 启动时匹配
//   exclude app-id="..." title="..." — 从匹配中排除特定窗口

// 从截图与录屏中屏蔽密码管理器 (只屏蔽录屏则改为 block-out-from "screencast")
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#

    block-out-from "screen-capture"
}

// 所有窗口都应用的规则
window-rule {
    // 默认 xray=true (模糊壁纸); 非 xray 仅用于上方 top/overlay 层与下方浮动窗口。
    // --- 启用圆角 ---
    geometry-corner-radius 12
    clip-to-geometry true
    // 活动窗口 0.92、非活动窗口 0.85; 活动窗口更清晰, 同时保留轻微毛玻璃
    opacity 0.92
    draw-border-with-background false
    // 毛玻璃的 noise/saturation 由 config.kdl 的全局 blur 块统一提供
    background-effect {
        blur true
    }
    // --- 右键菜单等弹出窗口 ---
    popups {
        opacity 0.88
        geometry-corner-radius 15
        background-effect {
            blur true
        }
    }
}

// 非活动窗口更透明 (0.85)。
window-rule {
    match is-active=false
    opacity 0.85
}

// 浮动窗口在全局 blur 基础上改用非 xray 模糊; 该模式仍是实验性的,
// 打开/关闭动画和拖动平铺窗口时可能消失。
window-rule {
    match is-floating=true

    background-effect {
        xray false
    }
}

// 默认以浮动模式打开 Firefox 画中画播放器
window-rule {
    // 此 app-id 正则表达式适用于两者：
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// 正在被单独录制的窗口: 红色焦点环提示 (25.02+), 用于确认当前共享的是哪个窗口。
window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }
}

// --- 以下为新增窗口规则属性示例，默认全部注释 ---

// 示例：窗口打开时行为控制
/-window-rule {
    match app-id="firefox$"

    // 窗口以最大化列形式打开
    // open-maximized true

    // 最大化到屏幕边缘（不计入间隙）
    // open-maximized-to-edges true

    // 窗口以全屏形式打开
    // 也可设为 false 阻止全屏（如 Telegram 媒体查看器）
    // open-fullscreen true

    // 窗口以浮动模式打开
    // open-floating true

    // 指定窗口打开的显示器（支持名称如 "HDMI-A-1" 或描述如 "Some Company Monitor"）
    // open-on-output "HDMI-A-1"

    // 指定窗口打开的工作区（需配合命名工作区声明）
    // open-on-workspace "chat"

    // 窗口打开时不聚焦
    // open-focused false

    // 新窗口的默认高度
    // default-window-height { fixed 500; }

    // 浮动窗口的默认位置
    // default-floating-position x=100 y=200 relative-to="bottom-left"

    // 特定窗口触发可变刷新率（需配合 output 的 on-demand=true）
    // variable-refresh-rate true

    // 窗口的滚动速度因子（<1 更慢，>1 更快）
    // scroll-factor 0.75

    // 该窗口所在列的默认显示模式
    // default-column-display "tabbed"

    // 窗口尺寸约束
    // min-width 100
    // max-width 200
    // min-height 300
    // max-height 300

    // 告知窗口它处于平铺状态（通常会让窗口变矩形并隐藏客户端阴影）
    // tiled-state true

    // 让窗口上下浮动（25.02+ 愚人节功能）
    // baba-is-float true
}

