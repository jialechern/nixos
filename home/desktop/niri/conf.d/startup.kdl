// startup.kdl
// 此处存放 niri 环境初始化过程中 必要/可选 的自启动程序

// 添加类似此行以在启动时生成进程
// 注意：niri 作为 systemd session 运行时已支持 xdg-desktop-autostart，
// GNOME/KDE 中配置的自启动应用会自动生效，无需在 niri 中手动配置。
// 要运行 shell 命令（包含变量、管道等），请使用 spawn-sh-at-startup：
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"
// 更多生成示例请参阅下面的 binds 部分

// --- --- --- niri 初始化配置 --- --- ---

// 保留: niri 的 environment {} 不会进入 systemd/D-Bus, 本行作为 niri 的子进程
// 把它的覆盖值 (见 env.kdl) 上报给 D-Bus 激活环境
spawn-at-startup "dbus-update-activation-environment" "--all"

// XWayland: niri >= 25.08 已内置 xwayland-satellite 集成 (只要它在 $PATH),
// 不要再手动 spawn; 自定义路径或禁用用顶层 xwayland-satellite { path "…" } / { off }
// 壁纸初始化
// 每次开机随机选取一张壁纸 (递归: find 枚举 ~/Wallpapers 下全部子目录, 再交给 waypaper 的随机逻辑)
spawn-sh-at-startup "find -L \"$HOME/Wallpapers\" -type d -print0 | xargs -0 -r waypaper --backend awww --fill fill --random --folder"
// // 每次开机选取给定路径下的 `default(不限后缀名)` 壁纸
// spawn-sh-at-startup "find -L \"$HOME/Wallpapers\" -type f -path \"*default*\" -exec waypaper --backend awww --wallpaper {} --fill fill \\;"

// --- --- --- 应用程序配置 --- --- ---

